; $VER: Install-Example 1.0 (4.11.2026)
; An OpenInstaller script that also runs on Commodore's Installer: the
; extras are only used when @openinstaller is set.

(set #app "Example")
(set @app-name #app)
(set #dest (askdir (prompt "Where should " #app " go? A drawer called " #app " is made there.")
                   (help @askdir-help)
                   (default @default-dest)))
(set #dest (tackon #dest #app))
(set @default-dest #dest)

(welcome)

(if @openinstaller
    (panel "Example.iff" (caption "Getting ready")))

(makedir #dest (infos) (prompt "Making the drawer " #dest))

(if @openinstaller
    (if (netavailable)
        (
            (panel "Downloading.gif" (caption "Downloading"))
            (download (source "https://example.org/files/example-1.0.lha")
                      (dest "T:")
                      (ifmissing)
                      (prompt "Downloading the program")
                      (optional "nofail"))
        )
        (message "There's no network: the download is left out.")
    )
)

(working "Copying the files")
(copyfiles (source "") (dest #dest) (pattern "#?.txt") (infos) (optional "nofail"))
(complete 100)

(if @openinstaller
    (panel ""))
(exit "Example is installed in " #dest ".")
