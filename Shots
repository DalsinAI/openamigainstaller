; lab only: pages for the README's screenshots
(set @app-name "MyGame")
(set #pics "Work:OpenInstaller/Examples/Pictures")
(message "This page has no picture of its own, so the panel shows the AmigaChrome logo.\n\nA script changes it with (panel \"file\")." (all))
(set #what (askoptions (prompt "What should be installed?")
                       (help @askoptions-help)
                       (choices "The game" "The manual" "The music pack (downloaded, 740 KB)")
                       (default %111)))
(panel (tackon #pics "download.gif") (caption "Downloading the music pack"))
(download (prompt "Downloading the music pack")
          (help "It comes over HTTPS.")
          (source "https://raw.githubusercontent.com/DalsinAI/openamigainstaller/d11858d/rc1.lha")
          (dest "RAM:music.lha"))
(panel (tackon #pics "done.png") (caption "MyGame 2.0"))
(exit "MyGame is installed.")
